+
+
+/* ADS declutter patch v3 */
+.sld-panel > .panel-head {
+  max-width: 200px;
+  padding: 7px 10px;
+}
+
+.sld-panel > .panel-head p {
+  display: none;
+}
+
+.ads-command-bar {
+  left: 226px;
+  right: 52px;
+  background: rgba(255,255,255,.78);
+  box-shadow: 0 10px 24px rgba(15, 80, 72, .09);
+}
+
+.command-btn {
+  min-height: 29px;
+  font-size: 10px;
+}
+
+.ads-drawer {
+  width: min(340px, 26vw);
+}
+
+.brain-metric-grid {
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+}
+
+.decision-steps {
+  display: none;
+}
+
+.target-section-head {
+  margin-top: 14px;
+}
+
+.premium-target-list {
+  max-height: 44vh;
+  overflow: auto;
+}
+
+.sld-overlay {
+  display: none !important;
+}
+
+.sld-overlay.preview-compact {
+  display: block !important;
+}
+
+@media (max-width: 1280px) {
+  .ads-command-bar {
+    left: 210px;
+  }
+
+  .ads-drawer {
+    width: min(320px, 32vw);
+  }
+}
